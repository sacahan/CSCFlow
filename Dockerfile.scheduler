FROM python:3.12-slim

WORKDIR /app

# 安裝必要的工具以支持依賴安裝
RUN apt-get update && apt-get install -y gcc python3-dev && rm -rf /var/lib/apt/lists/*

# 複製 pyproject.toml 並生成 requirements.txt
COPY pyproject.toml ./
RUN pip install pip-tools && pip-compile pyproject.toml

# 使用生成的 requirements.txt 安裝依賴
RUN pip install -r requirements.txt

# 複製排程器代碼
COPY src/schedulers ./src/schedulers
COPY src/database ./src/database

# 設定環境變數
ENV PYTHONPATH=/app
# 確保 Python 的 log 標準輸出到 Docker log
ENV PYTHONUNBUFFERED=1

# 設定 CMD 指令，直接執行排程器的 "run" 模式
CMD ["python3", "-c", "import asyncio; from src.schedulers.run_scheduler import main; asyncio.run(main('run'))"]
