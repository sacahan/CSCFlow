# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_RATE_LIMIT_DB=1

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgresql:paspostgresqlsword@localhost:5432/postgresql"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=3600

# Redis Cache Duration
REDIS_CACHE_DURATION=3600  # Cache duration in seconds

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Environment Configuration
ENV=development  # development, production, testing
DEBUG=true

# Admin Account Configuration
API_USERNAME=admin
API_PASSWORD=admin

# JWT Configuration
JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
